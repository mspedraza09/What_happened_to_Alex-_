[node name="Fecha" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "Sin remitente — encontrada junto al teléfono"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.50, 0.55, 0.65, 1.0)

[node name="Separador" type="ColorRect" parent="CartaPanel/CartaContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 1)
color = Color(0.25, 0.30, 0.45, 0.5)

[node name="ParrafoSaludo" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "Alex,"
autowrap_mode = 3
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.88, 0.88, 0.95, 1.0)

[node name="Parrafo1" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "Si estás leyendo esto, ya sé que encontraste el teléfono.\nTambién sé que vas a querer entrar. Así que te voy a dar\nuna pista — pero solo una, así que presta atención."
autowrap_mode = 3
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.78, 0.80, 0.90, 1.0)

[node name="Parrafo2" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "La clave no es una palabra. Es una fecha. Pero no cualquier\nfecha: es la primera vez que alguien te llamó por ese nombre\nque tanto odias. El mismo día que borraste todas las fotos\nde ese año. El mismo día que empezó todo."
autowrap_mode = 3
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.78, 0.80, 0.90, 1.0)

[node name="Parrafo3" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "Recuerdas ese martes de noviembre. La clase de Historia.\nFila cuatro. El mensaje llegó a las tres y cuarto de la tarde,\npero tú ya lo habías visto a las dos. El año en el que\ncumpliste dieciséis."
autowrap_mode = 3
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.78, 0.80, 0.90, 1.0)

[node name="Parrafo4" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "El teléfono tiene cuatro dígitos. Ya sabes cuáles son."
autowrap_mode = 3
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.88, 0.88, 0.95, 1.0)

[node name="Firma" type="Label" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "— ██████"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.40, 0.42, 0.50, 1.0)

[node name="BtnContinuar" type="Button" parent="CartaPanel/CartaContent"]
layout_mode = 2
text = "Ir al teléfono →"
theme_override_font_sizes/font_size = 13
custom_minimum_size = Vector2(0, 36)

